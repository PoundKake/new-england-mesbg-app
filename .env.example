# Copy to .env and fill in real values before running `docker compose up`.
# .env is gitignored — never commit real secrets.

# --- Postgres ---
POSTGRES_USER=mesbg
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mesbg

# Password for the "authenticator" role PostgREST connects as
# (see db/migrations/0002_roles.sh). Use a different password than
# POSTGRES_PASSWORD above.
AUTHENTICATOR_PASSWORD=change-me-different-strong-password

# --- Admin auth ---
# Shared secret: PostgREST verifies JWTs with this (PGRST_JWT_SECRET), and
# server/api/admin/login.post.ts signs them with this (NUXT_JWT_SECRET).
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-32-plus-random-bytes

# --- Deployment ---
# Public domain Caddy will request a TLS certificate for.
DOMAIN=mesbg.example.com

# --- Events page ---
# Settings > Integrate calendar > Calendar ID, on the Google Calendar you
# want embedded. The calendar must be shared as public ("See all event
# details") in Google Calendar's own settings, or the embed will show
# nothing to visitors — that step can't be done from this codebase.
GOOGLE_CALENDAR_ID=example@group.calendar.google.com

# --- Backups (optional, defaults shown) ---
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
